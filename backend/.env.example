#
# LOCAL DEVELOPMENT  ->  copy this file to backend/.env
#
# With nothing else set, LedgerFlow runs the whole demo on this laptop:
# documents go to .data/documents.json, files to .data/uploads/, and
# extraction uses the built-in sample invoices. No AWS account needed.
#

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# The Next.js dev server. Comma-separate to allow more than one.
CORS_ORIGIN=http://localhost:3000

ORG_ID=demo
MAX_UPLOAD_MB=15

# ---------------------------------------------------------------------------
# Local storage (used because S3_BUCKET / DYNAMODB_TABLE are left unset)
# ---------------------------------------------------------------------------
LOCAL_STORAGE_DIR=.data/uploads
LOCAL_DB_FILE=.data/documents.json

# ---------------------------------------------------------------------------
# Vendor notifications — missing-detail requests and decline notices.
#
# Without SMTP settings the emails are simulated: logged and recorded in the
# document's audit trail, never delivered. That keeps the demo self-contained.
# ---------------------------------------------------------------------------
VENDOR_NOTIFY_EMAIL=nitiniszod10@gmail.com

# For real Gmail delivery, create an App Password:
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=your.address@gmail.com

# ---------------------------------------------------------------------------
# Gemini — the model provider. OPTIONAL locally.
#
# Get a key from https://aistudio.google.com/apikey. Without it, extraction
# uses the built-in sample invoices; with it, Gemini reads uploaded documents.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
# Reasoning depth: off | minimal | low | medium | high. Transcription needs
# little, and thinking tokens come out of the same output budget.
GEMINI_THINKING_LEVEL=low
# "auto" turns Gemini on whenever a key is present; "false" forces samples.
ENABLE_GEMINI=auto

# ---------------------------------------------------------------------------
# AWS — every line below is OPTIONAL locally.
#
# Leave them commented out and files stay on disk and records in a JSON file.
# Uncomment a line to move that one capability onto AWS; the rest keep
# working locally. GET /health reports which adapters are actually live.
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1

# Uncomment to store uploaded files in a private S3 bucket instead of on disk.
# S3_BUCKET=ledgerflow-private-documents-<your-suffix>

# Uncomment to store document records in DynamoDB instead of a JSON file.
# DYNAMODB_TABLE=ledgerflow-documents

# Real OCR. "auto" turns Textract on only when AWS credentials are reachable,
# so an unconfigured laptop silently skips it. Set "false" to force it off.
ENABLE_TEXTRACT=auto

# NEVER put AWS keys in this file for a deployed environment - App Runner uses
# an IAM instance role. Locally, use `aws configure` or a named profile:
# AWS_PROFILE=ledgerflow
