#
# DEPLOYED BACKEND (AWS App Runner)  ->  paste these as App Runner
# environment variables. Do NOT commit a filled-in copy.
#
# Difference from local: everything is on AWS, CORS points at the Vercel
# domain instead of localhost, and there are no AWS keys anywhere - the
# App Runner instance role supplies credentials.
#

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# The Vercel production domain. No trailing slash. Add preview domains
# comma-separated if you want preview deploys to reach this API.
CORS_ORIGIN=https://ledgerflow.vercel.app

ORG_ID=demo
MAX_UPLOAD_MB=15

# --- AWS resources (all required in production) -----------------------------
AWS_REGION=ap-south-1
S3_BUCKET=ledgerflow-private-documents-<your-suffix>
DYNAMODB_TABLE=ledgerflow-documents

ENABLE_TEXTRACT=true

# --- Gemini (the model provider) --------------------------------------------
# Key from https://aistudio.google.com/apikey. Store it as a secret in
# App Runner rather than in plain configuration where you can.
GEMINI_API_KEY=your-gemini-api-key
ENABLE_GEMINI=true
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low

# Do not set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
# Attach the LedgerFlowAppRunnerInstanceRole instead - see AWS_SETUP.md.
